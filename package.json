{
  "name": "solana-sniper",
  "version": "0.1.0",
  "description": "Second-wave Solana micro-cap token screener and auto-trader",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "tsx watch src/bot.ts",
