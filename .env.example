# =============================================================================
# Solana second-wave micro-cap sniper — configuration
#
# Copy to .env and chmod 600. This file will hold a private key that controls
# real funds; it must never be committed or world-readable.
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Wallet
# -----------------------------------------------------------------------------
# Solana keypair. Two accepted formats:
#   1. base58 string (what Phantom/Solflare "export private key" gives you)
#   2. the raw 64-byte JSON array from: solana-keygen new --outfile ~/sniper-wallet.json
#
# Use a DEDICATED wallet holding only what you are prepared to lose. This key is
# loaded into a process that submits swaps automatically.
# Required when DRY_RUN=false. If left blank under DRY_RUN=true the bot generates
# a throwaway keypair so you can paper-trade without funding anything.
WALLET_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# RPC
# -----------------------------------------------------------------------------
# Free key at https://helius.dev (or Triton One / QuickNode).
# The public endpoint https://api.mainnet-beta.solana.com WILL rate-limit this
# bot into uselessness — it makes several calls per candidate per minute.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Jupiter swap API. The old quote-api.jup.ag/v6 host no longer resolves at all.
#   https://lite-api.jup.ag/swap/v1   free, no key           <- default
#   https://api.jup.ag/swap/v1        requires JUPITER_API_KEY
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# -----------------------------------------------------------------------------
# Strategy
# -----------------------------------------------------------------------------
POSITION_SIZE_USDC=25          # USDC spent per token buy
MAX_POSITIONS=5                # Max simultaneous open positions
MIN_SAFETY_SCORE=60            # Minimum score (0-100) required to buy
MIN_AGE_SECONDS=45             # Wait this long after pool creation before buying —
                               #   this is the "second wave" delay that skips the snipe spike
MAX_AGE_SECONDS=1800           # Ignore pools older than this (30 min); past this it is
                               #   no longer a new listing and the thesis does not apply
MIN_LIQUIDITY_USD=5000         # Minimum pool liquidity, USD
MIN_TRANSACTIONS=50            # Minimum tx count in the 5-minute bucket (see README:
                               #   DexScreener has no 1-minute bucket)
MAX_TOP10_HOLDER_PCT=80        # Disqualify if the top 10 non-LP holders exceed this %

# --- Honeypot guards. Neither was in the original design; both were added after
# --- a live token passed every other check and still lost 81% on an instant
# --- round trip (a Token-2022 mint with a transfer-fee extension).
MAX_TRANSFER_FEE_BPS=100       # Reject Token-2022 mints whose transfer fee exceeds this.
                               #   100 bps = 1%. Set 0 to reject any transfer fee at all.
MAX_ROUND_TRIP_LOSS_PCT=15     # Before buying, quote selling straight back. If the immediate
                               #   loss exceeds this, do not enter. Catches honeypots, one-sided
                               #   pools, and pools too thin for POSITION_SIZE_USDC.
                               #   Measured baseline on healthy tokens: ~3%.

TAKE_PROFIT_PCT=150            # Take profit at +150% (2.5x)
STOP_LOSS_PCT=40               # Cut at -40%
TRAILING_STOP_PCT=25           # Once armed, trail 25% below the peak price
TRAILING_ACTIVATE_PCT=50       # Arm the trailing stop at +50%.
                               #   READ THE README BEFORE LEAVING THIS AT 50. Arming the trail
                               #   below TAKE_PROFIT_PCT means nearly every winner is cut on a
                               #   routine retrace and the +150% target almost never fires, which
                               #   pushes the break-even win rate from ~25% to ~60%.
                               #   Set this to 150 (= TAKE_PROFIT_PCT) so the trail protects the
                               #   free-ride remainder instead of capping the winners.
PARTIAL_SELL_PCT=75            # Sell this % at take profit; the rest free-rides on the trail
MAX_HOLD_MINUTES=60            # Force market exit after this many minutes

# -----------------------------------------------------------------------------
# Fees and slippage
# -----------------------------------------------------------------------------
PRIORITY_FEE_LAMPORTS=100000   # Priority fee ceiling per tx (~0.0001 SOL)
SLIPPAGE_BPS=300               # 3% slippage tolerance on buys
SELL_SLIPPAGE_BPS=500          # 5% on sells — exits matter more than entries

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
DRY_RUN=true                   # true = simulate everything against real quotes, submit nothing.
                               #   LEAVE THIS TRUE until you have reviewed 24-48h of logs.
DISCOVERY_INTERVAL_MS=10000    # New-token scan interval
CANDIDATE_INTERVAL_MS=5000     # Candidate scoring interval
PRICE_POLL_INTERVAL_MS=3000    # Open-position mark-to-market interval
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR
ENABLE_WEBSOCKET=false         # DexScreener realtime feed. Their io.dexscreener.com endpoint is
                               #   undocumented and currently 404s on every known path, so this
                               #   defaults OFF. REST polling is the supported discovery route and
                               #   already surfaces far more tokens than the scorer can process.

# -----------------------------------------------------------------------------
# Filters
# -----------------------------------------------------------------------------
CHAIN=solana                   # Only solana is implemented
BLACKLIST_TOKENS=              # Comma-separated mint addresses to never buy
REQUIRE_RUGCHECK=true          # Disqualify when RugCheck cannot be reached. Setting this
                               #   false lets a token pass on other factors alone — that is
                               #   exactly the case where you are flying blind on rug risk.

# -----------------------------------------------------------------------------
# Hard safety rails
# -----------------------------------------------------------------------------
# Defaults to MAX_POSITIONS * POSITION_SIZE_USDC * 3 when unset.
MAX_DAILY_SPEND_USDC=375       # Hard cap on total USDC spent on buys per day
MAX_DAILY_LOSS_USDC=100        # Stop opening new positions once realized losses hit this.
                               #   Selling is never blocked.
MIN_SOL_BALANCE=0.05           # Refuse to buy below this SOL balance (transaction fees)
